{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receipt scanner OCR contract corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mergeCases", "qualityCases", "geometry"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mergeCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mergeCase"
      }
    },
    "qualityCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/qualityCase"
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantizeCases", "angleCases", "correctionCases", "boxCases", "quadCases"],
      "properties": {
        "quantizeCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/quantizeCase"
          }
        },
        "angleCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/angleCase"
          }
        },
        "correctionCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/correctionCase"
          }
        },
        "boxCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/boxCase"
          }
        },
        "quadCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/quadCase"
          }
        }
      }
    }
  },
  "$defs": {
    "indexes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "quality": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["textLength", "lineCount", "confidence"],
      "properties": {
        "textLength": {
          "type": "integer",
          "minimum": 0
        },
        "lineCount": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "mergeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pages", "rejectedPageIndexes", "expectedError", "expected"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pages": {
          "type": "array",
          "items": {
            "type": ["string", "null"]
          }
        },
        "rejectedPageIndexes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "expectedError": {
          "enum": [null, "RangeError"]
        },
        "expected": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["text", "isComplete", "unmatchedBoundaryIndexes", "rejectedPageIndexes"],
          "properties": {
            "text": {
              "type": "string"
            },
            "isComplete": {
              "type": "boolean"
            },
            "unmatchedBoundaryIndexes": {
              "$ref": "#/$defs/indexes"
            },
            "rejectedPageIndexes": {
              "$ref": "#/$defs/indexes"
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "expectedError": {
              "const": null
            },
            "expected": {
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "expectedError": {
              "const": "RangeError"
            },
            "expected": {
              "type": "null"
            }
          }
        }
      ]
    },
    "qualityCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "expected"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "ocr", "floor", "pages"],
          "properties": {
            "status": {
              "enum": ["success", "cancelled"]
            },
            "ocr": {
              "type": "boolean"
            },
            "floor": {
              "oneOf": [
                {
                  "const": null
                },
                {
                  "const": false
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["minTextLength", "minLines", "minConfidence"],
                  "properties": {
                    "minTextLength": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minLines": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minConfidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              ]
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text", "confidence"],
                "properties": {
                  "text": {
                    "type": ["string", "null"]
                  },
                  "confidence": {
                    "type": ["number", "null"],
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "acceptedPageIndexes", "rejectedPageIndexes", "qualities"],
          "properties": {
            "status": {
              "enum": ["success", "rejected", "cancelled"]
            },
            "acceptedPageIndexes": {
              "$ref": "#/$defs/indexes"
            },
            "rejectedPageIndexes": {
              "$ref": "#/$defs/indexes"
            },
            "qualities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/quality"
              }
            }
          }
        }
      }
    },
    "angle": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "enum": ["NaN", "+Infinity", "-Infinity"]
        }
      ]
    },
    "box": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "frame": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "quantizeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "degrees", "expected"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "degrees": {
          "type": "number"
        },
        "expected": {
          "enum": [0, 90, 180, 270]
        }
      }
    },
    "angleCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "angles", "expectedHistogram", "expectedDominant"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "angles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/angle"
          }
        },
        "expectedHistogram": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        },
        "expectedDominant": {
          "enum": [null, 0, 90, 180, 270]
        }
      }
    },
    "correctionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quarterTurn", "expected"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "quarterTurn": {
          "type": "integer"
        },
        "expected": {
          "enum": [0, 90, 180, 270]
        }
      }
    },
    "boxCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "frame",
        "box",
        "degrees",
        "expectedFrame",
        "expectedRotated",
        "expectedClamped"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "degrees": {
          "type": "integer"
        },
        "expectedFrame": {
          "$ref": "#/$defs/frame"
        },
        "expectedRotated": {
          "$ref": "#/$defs/box"
        },
        "expectedClamped": {
          "oneOf": [
            {
              "$ref": "#/$defs/box"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "quadCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "corners", "expectedDistorted"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "corners": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 8,
          "maxItems": 8
        },
        "expectedDistorted": {
          "type": "boolean"
        }
      }
    }
  }
}
