{
  "name": "react-native-receipt-scanner",
  "version": "1.0.0",
  "description": "Receipt document scanner for React Native. Wraps ML Kit (Android) and VisionKit + Vision (iOS) with a unified API for scanning, interactive perspective-crop, JPEG compression, EXIF extraction, and on-device OCR.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.ts",
    "src/*.tsx",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/src/test",
    "!android/src/androidTest",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/AGENTS.md",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-receipt-scanner-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "prepublishOnly": "node scripts/check-pod-version.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "release": "release-it --only-version",
    "web": "vite",
    "build:web": "vite build",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "watchman-reset": "watchman watch-del $PWD && watchman watch-project $PWD"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewDongminYoo/react-native-receipt-scanner.git"
  },
  "author": "Dongmin, Yu <ydm2790@gmail.com> (https://github.com/AndrewDongminYoo)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AndrewDongminYoo/react-native-receipt-scanner/issues"
  },
  "homepage": "https://github.com/AndrewDongminYoo/react-native-receipt-scanner#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/react": "^19.3.0",
    "del-cli": "^8.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "espree": "^11.2.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "release-it": "^21.1.1",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "resolutions": {
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "baseline-browser-mapping": "^2.11.0",
    "basic-ftp@npm:^5.3.1": "^6.2.3",
    "body-parser": "^2.4.0",
    "brace-expansion@npm:^1.1.7": "^1.1.21",
    "brace-expansion@npm:^2.0.2": "^2.1.7",
    "brace-expansion@npm:^5.0.5": "^5.0.12",
    "brace-expansion@npm:^5.0.8": "^5.0.12",
    "browserslist": "^4.28.7",
    "compression": "^1.8.2",
    "esbuild": "^0.28.1",
    "fast-xml-builder": "^1.1.7",
    "ip-address@npm:^10.1.1": "^10.7.1",
    "joi": "^17.13.6",
    "js-yaml@npm:^3.13.1": "^3.15.2",
    "js-yaml@npm:^4.1.0": "^4.3.2",
    "js-yaml@npm:^4.1.1": "^4.3.2",
    "launch-editor": "^2.14.2",
    "nanoid@npm:^3.3.16": "^3.3.18",
    "postcss": "^8.5.18",
    "qs": "^6.16.0",
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "tar": "^7.5.21",
    "undici@npm:^6.25.0": "^6.29.1",
    "undici@npm:7.29.1": "^7.30.1",
    "vite": "^7.3.7",
    "ws@npm:^6.2.3": "^6.2.4",
    "ws@npm:^7": "^7.5.11",
    "ws@npm:^7.5.10": "^7.5.11"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "codegenConfig": {
    "name": "ReceiptScannerSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.receiptscanner"
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "jest",
      "release-it",
      "vite",
      "eslint"
    ],
    "version": "0.62.0"
  }
}
